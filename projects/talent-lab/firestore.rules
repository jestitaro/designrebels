rules_version = '2';

// Talent Lab by QuartzSales — Firestore rules for the talent-lab project.
// Complete, standalone ruleset (talent-lab hosts no other app) — deploy as-is
// with `firebase deploy --only firestore:rules`.
//
// Model: anyone signed in can create their own Lab, post updates to a Lab
// they own, and leave feedback (rating + comment) on any update. Nothing is
// ever deleted or edited from the client in v1 — see README "Pendiente".
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsLab(labId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/talentlab_labs/$(labId)) &&
        get(/databases/$(database)/documents/talentlab_labs/$(labId)).data.ownerUid == request.auth.uid;
    }

    // Public profile per user (displayName shown next to labs/updates/feedback).
    // Created once by the client right after signup; a user can only ever
    // touch their own doc, and can never set someone else's uid as theirs.
    match /talentlab_profiles/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // One Lab per initiative. Publicly readable. Only the signed-in creator
    // can create it (ownerUid must be their own uid) and later edit their
    // own Lab's copy (name/tagline/description/links) — ownerUid itself is
    // immutable once set.
    match /talentlab_labs/{labId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsLab(labId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    // Progress updates posted to a Lab's timeline. Publicly readable. Only
    // the Lab's own owner can post to it, as themselves.
    match /talentlab_updates/{updateId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && ownsLab(request.resource.data.labId);
      allow update, delete: if false;
    }

    // Feedback (rating 1-5 + comment) on an update. Publicly readable so
    // ratings can be averaged client-side. Anyone signed in can leave it, as
    // themselves, with a rating in range.
    match /talentlab_feedback/{feedbackId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }
  }
}
